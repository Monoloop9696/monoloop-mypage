# ============================================
# .env のテンプレート。実値は .env に入れる（.env はコミット禁止）
# Vercel にデプロイする際は、下記をすべて Vercel の Environment Variables にも登録する
# ============================================

# --- Firebase クライアント（VITE_ 接頭辞＝ブラウザに露出してOK） ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_LINE_ADD_FRIEND_URL=""

# --- サーバー専用（VITE_ を付けない） ---
RESEND_API_KEY=""
MAIL_FROM="onboarding@resend.dev"
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
ADMIN_EMAILS="admin1@example.com,admin2@example.com"
INITIAL_PASSWORD_2027=""
INITIAL_PASSWORD_2028=""

# Firebase Admin SDK サービスアカウント（1行JSON または base64）
FIREBASE_SERVICE_ACCOUNT=""
